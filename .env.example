# ============================================================================
# IoT IDS/IPS Environment Configuration Template
# ============================================================================
# Copy this file to .env and fill in the values before running the system.
# All variables marked as REQUIRED must be set for the system to start.
# ============================================================================

# ----------------------------------------------------------------------------
# Database Configuration
# ----------------------------------------------------------------------------
# PostgreSQL connection URL for the IDS/IPS database
# Format: postgresql://username:password@host:port/database
# REQUIRED
DATABASE_URL=postgresql://idsuser:replace-with-url-safe-password@localhost:5432/idsdb

# Password for the PostgreSQL container when using Docker Compose
# Use letters, numbers, hyphens, or underscores so it is safe inside DATABASE_URL.
POSTGRES_PASSWORD=

# ----------------------------------------------------------------------------
# JWT Authentication
# ----------------------------------------------------------------------------
# Secret key for signing JWT tokens (HS256 algorithm)
# Generate with: openssl rand -hex 32
# REQUIRED - MUST be kept secret and never committed to version control
JWT_SECRET_KEY=your-secret-key-here-replace-with-random-32-byte-hex

# JWT token expiration time in minutes
# Default: 60 minutes (1 hour)
JWT_EXPIRE_MINUTES=60

# ----------------------------------------------------------------------------
# LLM / Ollama Configuration
# ----------------------------------------------------------------------------
# Ollama API endpoint for LLM-based threat analysis
# For local development: http://localhost:11434
OLLAMA_HOST=http://localhost:11434

# Ollama model to use for threat analysis
# Default: qwen2.5:1.5b (recommended for security analysis: qwen2.5:1.5b)
OLLAMA_MODEL=qwen2.5-3b-iot-ids

# LLM request timeout in seconds
# Default: 5 seconds (falls back to rule-based analysis on timeout)
LLM_TIMEOUT_SECONDS=5

# ----------------------------------------------------------------------------
# Loki / Grafana Stack Configuration
# ----------------------------------------------------------------------------
# Grafana SMTP configuration for IDS email alerts
# For Gmail, use a Google app password, not your normal account password.
GF_SMTP_ENABLED=true
GF_SMTP_HOST=smtp.gmail.com:587
GF_SMTP_USER=your-email@example.com
GF_SMTP_PASSWORD=your-gmail-app-password
GF_SMTP_FROM_ADDRESS=your-email@example.com
GF_SMTP_FROM_NAME=IoT IDS/IPS
GF_SMTP_STARTTLS_POLICY=MandatoryStartTLS

# Loki URL for log queries and ingestion
LOKI_URL=http://localhost:3100

# Grafana URL for log visualization
GRAFANA_URL=http://localhost:3000

# Local log file path that Promtail will tail
APP_LOG_PATH=logs/ids_system.log

# ----------------------------------------------------------------------------
# CORS Configuration
# ----------------------------------------------------------------------------
# Comma-separated list of allowed origins for CORS
# Include the dashboard URL to allow API requests from the frontend
# Example: http://localhost:3000,http://localhost:5173,https://dashboard.example.com
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# ----------------------------------------------------------------------------
# Application Configuration
# ----------------------------------------------------------------------------
# Application environment (development, staging, production)
ENVIRONMENT=development

# Log level for application logging
# Options: DEBUG, INFO, WARNING, ERROR, CRITICAL
LOG_LEVEL=INFO

# Software version (for startup logging and health checks)
APP_VERSION=1.0.0

# ----------------------------------------------------------------------------
# ML Model Configuration
# ----------------------------------------------------------------------------
# Path to the trained supervised classifier model file
LGB_MODEL_PATH=models/lgb_model_optimized.joblib

# Path to the trained Isolation Forest model file
IF_MODEL_PATH=models/if_model.joblib

# Path to the feature scaler file
SCALER_PATH=models/scaler_optimized.joblib

# Path to the protocol label encoder file
LE_PROTOCOL_PATH=models/le_protocol.joblib

# Path to the flags label encoder file
LE_FLAGS_PATH=models/le_flags.joblib

# ----------------------------------------------------------------------------
# Agent Queue Configuration
# ----------------------------------------------------------------------------
# Maximum queue capacity for inter-agent communication
# Default: 1000 items per queue
QUEUE_CAPACITY=1000

# Queue drain timeout during graceful shutdown (seconds)
# Default: 30 seconds for main queues, 10 seconds for logging queue
QUEUE_DRAIN_TIMEOUT=30

# ----------------------------------------------------------------------------
# Firewall Configuration
# ----------------------------------------------------------------------------
# Firewall mode: production or simulation
# production: Execute real iptables commands (requires root/CAP_NET_ADMIN)
# simulation: Log commands without executing (for testing)
FIREWALL_MODE=simulation

# Default TTL for firewall block rules (seconds)
# Default: 3600 seconds (1 hour)
FIREWALL_BLOCK_TTL=3600

# Default TTL for rate limit rules (seconds)
# Default: 1800 seconds (30 minutes)
FIREWALL_RATE_LIMIT_TTL=1800

# ----------------------------------------------------------------------------
# Threat Intelligence Configuration
# ----------------------------------------------------------------------------
# Enable/disable threat intelligence integration
THREAT_INTEL_ENABLED=false

# Threat intelligence API endpoint (if enabled)
THREAT_INTEL_API_URL=https://api.threatintel.example.com

# Threat intelligence API key (if enabled)
THREAT_INTEL_API_KEY=your-api-key-here

# Threat intelligence update interval (hours)
THREAT_INTEL_UPDATE_INTERVAL=6

# ----------------------------------------------------------------------------
# Monitoring and Metrics
# ----------------------------------------------------------------------------
# Enable Prometheus metrics export at /metrics endpoint
METRICS_ENABLED=true

# Metrics collection interval (seconds)
METRICS_INTERVAL=10

# ----------------------------------------------------------------------------
# Traffic Capture Configuration
# ----------------------------------------------------------------------------
# Path to Suricata eve.json log file
SURICATA_LOG_PATH=/var/log/suricata/eve.json

# Path to Zeek connection log file (relative to the repository root)
ZEEK_LOG_PATH=logs/zeek/current/conn.log

# Enable traffic capture agents
TRAFFIC_CAPTURE_ENABLED=true

# ----------------------------------------------------------------------------
# Healing Agent Configuration
# ----------------------------------------------------------------------------
# Maximum retry attempts for service restart
HEALING_MAX_RETRIES=3

# Exponential backoff base (seconds) for service restart retries
HEALING_BACKOFF_BASE=2

# Enable automatic service healing
HEALING_ENABLED=true

# ----------------------------------------------------------------------------
# Reporting Configuration
# ----------------------------------------------------------------------------
# Enable automatic report generation
REPORTING_ENABLED=true

# Report generation schedule (cron format)
# Default: Daily at 00:00 UTC
REPORT_SCHEDULE=0 0 * * *

# Report retention days
REPORT_RETENTION_DAYS=90

# ----------------------------------------------------------------------------
# Development / Testing Configuration
# ----------------------------------------------------------------------------
# Enable debug mode (verbose logging, detailed error messages)
DEBUG=false

# Enable mock data generation for testing
MOCK_DATA_ENABLED=false

# Mock traffic generation rate (events per second)
MOCK_TRAFFIC_RATE=10

# ----------------------------------------------------------------------------
# Grafana admin password (required for Docker Compose)
GF_SECURITY_ADMIN_PASSWORD=

# ----------------------------------------------------------------------------
# Admin User Seeding (first-run only)
# ----------------------------------------------------------------------------
# Set both values to create the first application admin account; password must be at least 12 characters.
# If either is blank, admin seeding is skipped.
ADMIN_USERNAME=
ADMIN_PASSWORD=
